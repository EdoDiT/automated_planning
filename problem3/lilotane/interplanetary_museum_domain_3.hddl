(define (domain interplanetary_museum_domain_3)
	(:requirements :strips :typing :hierarchy :negative-preconditions)
	(:types
		location - object
		entity - object
		room - location
		carriable_item - entity
		artifact - carriable_item
		pod - carriable_item
		robot - entity
		sealing_curators - robot
		standard_curator - sealing_curators
		drone_curator - robot
		tank_curator - sealing_curators
    )
	(:constants
		pod_pickup - location
		tunnel - location
		hall_beta - room
	)
    (:predicates
        (at ?arg0 - entity ?arg1 - location)
		(is_freezing ?arg0 - location)
		(are_connected  ?departure - location ?destination - location)
		(is_vibration_free ?arg0 - location)
		(is_sensitive ?arg0 - artifact)
		(is_seismic_sensitive ?arg0 - artifact)
		(is_thermosensitive ?arg0 - artifact)
		(is_idle ?arg0 - robot)
		(on ?arg0 - carriable_item ?arg1 - robot)
		(in ?arg0 - artifact ?arg1 - pod)
		(pod_is_available ?arg0 - pod); available for pickup
		(pod_is_empty ?arg0 - pod); no artifact inside
		(is_sealed ?arg0 - robot)
		(is_full ?arg0 - robot)
		(is_unpodded ?arg0 - robot)
    )

	(:action activate_robot
		:parameters (?agent - robot)
		:precondition (and
			(is_idle ?agent)
		)
		:effect (and
			(not (is_idle ?agent))
		)
	)

	(:action pickup_standard_artifact
		:parameters (?agent - robot ?artifact - artifact ?room - room)
		:precondition (and
			(not (is_full ?agent))
			(not (is_sealed ?agent))
			(at ?agent ?room)
			(at ?artifact ?room)
			(not (is_sensitive ?artifact))
		)
		:effect (and
			(is_full ?agent)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
		)
	)

	(:action drop_standard_artifact
		:parameters (?agent - robot ?artifact - artifact ?room - room)
		:precondition (and
			(on ?artifact ?agent)
			(at ?agent ?room)
			(not (is_sealed ?agent))
			(not (is_sensitive ?artifact))
			(is_full ?agent)
		)
		:effect (and
			(not (on ?artifact ?agent))
			(at ?artifact ?room)
			(not (is_full ?agent))
		)
	)

	(:action pickup_thermosensitive_artifact
		:parameters (?agent - drone_curator ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(at ?agent ?room)
			(pod_is_empty ?pod)
			(is_sensitive ?artifact)
			(is_thermosensitive ?artifact)
			(at ?artifact ?room)
			(not (is_full ?agent))
		)
		:effect (and
			(is_full ?agent)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(not (pod_is_empty ?pod))
		)
	)
	

	(:action pickup_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(on ?pod ?agent)
			(not (is_sealed ?agent))
			(on ?pod ?agent)
			(pod_is_empty ?pod)
			(is_sensitive ?artifact)
			(at ?agent ?room)
			(at ?artifact ?room)
			(not (is_full ?agent))
		)
		:effect (and
			(not (pod_is_empty ?pod))
			(is_full ?agent)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
			(in ?artifact ?pod)
		)
	)

	(:action safe_drop_seismic_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(on ?pod ?agent)
			(not (is_sealed ?agent))
			(on ?pod ?agent)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_seismic_sensitive ?artifact)
			(is_vibration_free ?room)
			(at ?agent ?room)
			(is_full ?agent)
		)
		:effect (and
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(not (is_full ?agent))
		)
	)

	(:action safe_drop_thermosensitive_artifact
		:parameters (?agent - robot ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(on ?pod ?agent)
			(not (is_sealed ?agent))
			(on ?pod ?agent)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_thermosensitive ?artifact)
			(is_freezing ?room)
			(at ?agent ?room)
			(is_full ?agent)
		)
		:effect (and
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(not (is_full ?agent))
		)
	)

	(:action safe_drop_seismic_and_thermo_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(on ?pod ?agent)
			(not (is_sealed ?agent))
			(on ?pod ?agent)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_thermosensitive ?artifact)
			(is_seismic_sensitive ?artifact)
			(is_vibration_free ?room)
			(is_freezing ?room)
			(at ?agent ?room)
			(is_full ?agent)
		)
		:effect (and
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(not (is_full ?agent))
		)
	)
	
	(:action fly
		:parameters (?agent - drone_curator ?departure - location ?destination - location)
		:precondition (and
			(at ?agent ?departure)
			(are_connected ?departure ?destination)
		)
		:effect (and 
			(not (at ?agent ?departure))
			(at ?agent ?destination)
		)
	)
	
	(:action move
		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
		:precondition (and
			(at ?agent ?departure)
			(is_sealed ?agent)
			(are_connected ?departure ?destination)
		)
		:effect (and
			(not (at ?agent ?departure))
			(at ?agent ?destination)
		)
	)

	(:action seal
		:parameters (?agent - sealing_curators)
		:precondition (and
			(is_unsealed ?agent)
		)
		:effect (and
			(not (is_unsealed ?agent))
			(is_sealed ?agent)
		)
	)

	(:action unseal
		:parameters (?agent - sealing_curators)
		:precondition (and
			(is_sealed ?agent)
		)
		:effect (and
			(not (is_sealed ?agent))
			(is_unsealed ?agent)
		)
	)

	(:action take_pod
		:parameters (?agent - robot ?pod - pod)
		:precondition (and
			(at ?agent pod_pickup)
			(at ?pod pod_pickup)
			(is_unsealed ?agent)
			(pod_is_empty ?pod)
			(pod_is_available ?pod)
			(is_unpodded ?agent)
		)
		:effect (and
			(not (is_unpodded ?agent))
			(not(at ?pod pod_pickup))
			(not(pod_is_available ?pod))
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
		)
	)

	(:action drop_pod
		:parameters (?agent - robot ?pod - pod)
		:precondition (and
			(at ?agent pod_pickup)
			(is_unsealed ?agent)
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:effect (and
			(not (on ?pod ?agent))
			(not (has_pod ?agent ?pod))
			(at ?pod pod_pickup)
			(pod_is_available ?pod)
			(is_unpodded ?agent)
		)
	)

	(:task unload_phase :parameters (?agent - robot ?room - room))

	(:method unload_one_standard_more
		:parameters (?agent - robot ?room - room ?artifact - artifact)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
		)
		:ordered-subtasks (and
			(drop_standard_artifact ?agent ?artifact ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_thermosensitive_more
		:parameters (?agent - robot ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_thermosensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_seismic_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_seismic_sensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_seismic_and_thermo_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_seismic_and_thermo_sensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method finish_unloading
		:parameters (?agent - robot ?room - room)
		:task (unload_phase ?agent ?room)
		:ordered-subtasks ()
	)

	(:task load_phase :parameters (?r - robot ?room - room))

	(:method load_one_standard_more
		:parameters (?agent - robot ?room - room ?artifact - artifact)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(is_not_full ?agent)
		)
		:ordered-subtasks (and
			(pickup_standard_artifact ?agent ?artifact ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method load_one_thermosensitive_more
		:parameters (?agent - drone_curator ?room - room ?artifact - artifact ?pod - pod)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(is_not_full ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(pickup_thermosensitive_artifact ?agent ?artifact ?pod ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method load_one_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(is_not_full ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(pickup_sensitive_artifact ?agent ?artifact ?pod ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method finish_loading
		:parameters (?agent - robot ?room - room)
		:task (load_phase ?agent ?room)
		:ordered-subtasks ()
	)

	(:task robot_travel
		:parameters (?agent - robot ?destination - location)
	)

	(:method already_at_destination
		:parameters (?agent - robot ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?destination)
		)
		:ordered-subtasks (
		)
	)

	(:method sealing_curator_travel
		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?departure)
			(is_unsealed ?agent)
		)
		:ordered-subtasks (and
			(seal ?agent)
			(move_robot ?agent ?departure ?destination)
			(unseal ?agent)
		)
	)

	(:method drone_curator_travel
		:parameters (?agent - drone_curator ?departure - location ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(move_robot ?agent ?departure ?destination)
		)
	)

	(:task move_robot
		:parameters (?r - robot ?departure - location ?destination - location)
	)
	
	(:method move_robot_one_location
  		:parameters (?agent - sealing_curators ?departure - location ?destination - location ?intermediate - location)
  		:task (move_robot ?agent ?departure ?destination)
		:precondition (and
			(is_sealed ?agent)
			(are_connected ?departure ?intermediate)
			(at ?agent ?departure)
		)
  		:ordered-subtasks (and
			(move ?agent ?departure ?intermediate)
			(move_robot ?agent ?intermediate ?destination)
  		)
	)

	(:method arrived_at_destination
  		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(at ?agent ?destination)
		)
  		:ordered-subtasks (
		)
	)

	(:method fly_drone_one_location
  		:parameters (?agent - drone_curator ?departure - location ?destination - location ?intermediate - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(are_connected ?departure ?intermediate)
		)
  		:ordered-subtasks (and
			(fly ?agent ?departure ?intermediate)
			(move_robot ?agent ?intermediate ?destination)
		)
	)

	(:method flown_at_destination
  		:parameters (?agent - drone_curator ?departure - location ?destination - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(at ?agent ?destination)
		)
  		:ordered-subtasks (
		)
	)

	(:task take_pods :parameters (?agent - robot))

	(:method take_one_pod
		:parameters (?agent - robot ?pod - pod)
		:task (take_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
			(is_unpodded ?agent)
			(pod_is_available ?pod)
			(at ?pod pod_pickup)
		)
		:ordered-subtasks (and
			(take_pod ?agent ?pod)
			(take_pods ?agent)
		)
	)

	(:method finish_taking_pods
		:parameters (?agent - robot)
		:task (take_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
		)
		:ordered-subtasks ()
	)

	(:task fetch_pods :parameters (?agent - robot))

	(:method fetch_pods_from_pod_pickup
		:parameters (?agent - robot)
		:task (fetch_pods ?agent)
		:precondition (and
			(is_unpodded ?agent)
		)
		:ordered-subtasks (and
			(robot_travel ?agent pod_pickup)
			(take_pods ?agent)
		)
	)

	(:task drop_pods :parameters (?agent - robot))

	(:method drop_one_pod
		:parameters (?agent - robot ?pod - pod)
		:task (drop_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(drop_pod ?agent ?pod)
			(drop_pods ?agent)
		)
	)

	(:method finish_dropping_pods
		:parameters (?agent - robot)
		:task (drop_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
		)
		:ordered-subtasks ()
	)

	(:task prepare_robot :parameters (?agent - robot ?departure - location))

	(:method prepare_nothing
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition ()
		:ordered-subtasks ()
	)

	(:method prepare_pods
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(fetch_pods ?agent)
		)
	)

	(:task service_room :parameters (?agent - robot ?room - room))

	(:method do_service_room
		:parameters (?agent - robot ?room - room)
		:task (service_room ?agent ?room)
		:ordered-subtasks (and
			(unload_phase ?agent ?room)
			(load_phase ?agent ?room)
		)
	)

	(:task conduct_tour :parameters (?agent - robot))

	(:method tour_next_stop
		:parameters (?agent - robot ?next_destination - room)
		:task (conduct_tour ?agent)
		:ordered-subtasks (and
			(robot_travel ?agent ?next_destination)
			(service_room ?agent ?next_destination)
			(conduct_tour ?agent)
		)
	)

	(:method finish_tour
		:parameters (?agent - robot)
		:task (conduct_tour ?agent)
		:ordered-subtasks ()
	)

	(:task tour_around :parameters (?agent - robot ?departure - location))

	(:method do_tour_around
		:parameters (?agent - robot ?departure - location)
		:task (tour_around ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(prepare_robot ?agent ?departure)
			(conduct_tour ?agent)
		)
	)

	(:task make_robot_work :parameters (?agent - robot))

	(:method deploy_for_work_once
		:parameters (?agent - robot ?departure - location)
		:task (make_robot_work ?agent)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(tour_around ?agent ?departure)
			(make_robot_work ?agent)
		)
	)
	
	(:method finish_work
		:parameters (?agent - robot)
		:task (make_robot_work ?agent)
		:ordered-subtasks ()
	)

	(:task manage_workforce)

	(:method deploy_one_more_robot
        :parameters (?agent - robot)
        :task (manage_workforce)
        :precondition (and
            (is_idle ?agent)
        )
        :subtasks (and
            (t_act (activate_robot ?agent))
            (t_work (make_robot_work ?agent))
            (t_rec (manage_workforce))
        )
        :ordering (and 
            (< t_act t_work)
            (< t_act t_rec)
        )
    )

	(:method finish_deployment
		:task (manage_workforce)
		:ordered-subtasks ()
	)

	(:task solve_problem)

    (:method run_main_task
        :task (solve_problem)
        :subtasks (and
            (t_workforce (manage_workforce))
        )
    )
)