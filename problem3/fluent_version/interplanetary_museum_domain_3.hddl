(define (domain interplanetary_museum_domain_3)
	(:requirements :strips :typing :fluents :hierarchy)
	(:types
		location - object
		entity - object
		room - location
		carriable_item - entity
		artifact - carriable_item
		pod - carriable_item
		robot - entity
		sealing_curators - robot
		standard_curator - sealing_curators
		drone_curator - robot
		tank_curator - sealing_curators
    )
	(:constants
		pod_pickup - location
		tunnel - location
		hall_beta - room)
    (:predicates
        (at ?arg0 - entity ?arg1 - location)
		(is_not_seisming ?arg0 - location)
		(is_seisming ?arg0 - location)
		(is_freezing ?arg0 - location)
		(are_connected  ?departure - location ?destination - location)
		(is_vibration_free ?arg0 - location)
		(is_safe ?arg0 - artifact)
		(is_sturdy ?arg0 - artifact)
		(is_sensitive ?arg0 - artifact)
		(is_thermosensitive ?arg0 - artifact)
		(is_seismic_sensitive ?arg0 - artifact)
		(is_thermo_and_seismic_sensitive ?arg0 - artifact)
		(is_idle ?arg0 - robot)
		(has_pod ?arg0 - robot ?arg1 - pod)
		(on ?arg0 - carriable_item ?arg1 - robot)
		(in ?arg0 - artifact ?arg1 - pod)
		(pod_is_available ?arg0 - pod); available for pickup
		(pod_is_empty ?arg0 - pod); no artifact inside
		(is_sealed ?arg0 - robot)
		(is_unsealed ?arg0 - robot)
    )
	(:functions
		(capacity_available ?arg0 - robot)
		(max_capacity ?arg0 - robot)
		(pod_capacity_available ?arg0 - robot)
		(max_pod_capacity ?arg0 - robot)
		(battery_level ?arg0 - robot)
		(max_battery_level ?arg0 - robot)
		(seismic_counter)
		(seismic_phase_duration)
	)

	(:action activate_robot
		:parameters (?agent - robot)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(is_idle ?agent)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(not (is_idle ?agent))
		)
	)

	(:action wait
		:parameters (?agent - robot)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) 5)
		)
	)

	(:action pickup_standard_artifact
		:parameters (?agent - robot ?artifact - artifact ?room - room)
		:precondition (and 
			(< (seismic_counter) (seismic_phase_duration))
			(> (capacity_available ?agent) 0)
			(is_unsealed ?agent)
			(at ?agent ?room)
			(at ?artifact ?room)
			(is_sturdy ?artifact)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(decrease (capacity_available ?agent) 1)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
		)
	)

	(:action drop_standard_artifact
		:parameters (?agent - robot ?artifact - artifact ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(on ?artifact ?agent)
			(at ?agent ?room)
			(is_unsealed ?agent)
			(is_sturdy ?artifact)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (on ?artifact ?agent))
			(increase (capacity_available ?agent) 1)
			(at ?artifact ?room)
			(is_safe ?artifact)
		)
	)

	(:action pickup_thermosensitive_artifact
		:parameters (?agent - drone_curator ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent ?room)
			(> (capacity_available ?agent) 0)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
			(is_sensitive ?artifact)
			(is_thermosensitive ?artifact)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(at ?artifact ?room)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(decrease (capacity_available ?agent) 1)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(not (pod_is_empty ?pod))
		)
	)
	

	(:action pickup_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(on ?pod ?agent)
			(is_unsealed ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
			(is_sensitive ?artifact)
			(> (capacity_available ?agent) 0)
			(at ?agent ?room)
			(at ?artifact ?room)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (pod_is_empty ?pod))
			(decrease (capacity_available ?agent) 1)
			(not (at ?artifact ?room))
			(on ?artifact ?agent)
			(in ?artifact ?pod)
		)
	)

	(:action safe_drop_seismic_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(on ?pod ?agent)
			(is_unsealed ?agent)
			(has_pod ?agent ?pod)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_seismic_sensitive ?artifact)
			(is_vibration_free ?room)
			(at ?agent ?room)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(increase (capacity_available ?agent) 1)
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(is_safe ?artifact)
		)
	)

	(:action safe_drop_thermosensitive_artifact
		:parameters (?agent - robot ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(on ?pod ?agent)
			(is_unsealed ?agent)
			(has_pod ?agent ?pod)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_thermosensitive ?artifact)
			(is_freezing ?room)
			(at ?agent ?room)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(increase (capacity_available ?agent) 1)	
			(is_safe ?artifact)
		)
	)

	(:action safe_drop_seismic_and_thermo_sensitive_artifact
		:parameters (?agent - sealing_curators ?artifact - artifact ?pod - pod ?room - room)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(on ?pod ?agent)
			(is_unsealed ?agent)
			(has_pod ?agent ?pod)
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(is_sensitive ?artifact)
			(is_thermo_and_seismic_sensitive ?artifact)
			(is_vibration_free ?room)
			(is_freezing ?room)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(at ?agent ?room)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (on ?artifact ?agent))
			(not (in ?artifact ?pod))
			(at ?artifact ?room)
			(pod_is_empty ?pod)
			(increase (capacity_available ?agent) 1)
			(is_safe ?artifact)
		)
	)
	
	(:action fly
		:parameters (?agent - drone_curator ?departure - location ?destination - location)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent ?departure)
			(are_connected ?departure ?destination)
			(> (battery_level ?agent) (+ (+ 200 (* 30 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 15 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and 
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 200 (*30 (- (max_capacity ?agent) (capacity_available ?agent)))) (*15 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (at ?agent ?departure))
			(at ?agent ?destination)
		)
	)
	
	(:action move
		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent ?departure)
			(is_sealed ?agent)
			(are_connected ?departure ?destination)
			(is_not_seisming ?destination)
			(> (battery_level ?agent) (+ (+ 100 (* 20 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 10 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 100 (* 20 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 10 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not (at ?agent ?departure))
			(at ?agent ?destination)
		)
	)

	(:action seal
		:parameters (?agent - sealing_curators)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(is_unsealed ?agent)
			(> (battery_level ?agent) 50)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) 50)
			(not (is_unsealed ?agent))
			(is_sealed ?agent)
		)
	)

	(:action unseal
		:parameters (?agent - sealing_curators)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(is_sealed ?agent)
			(> (battery_level ?agent) 50)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) 50)
			(not (is_sealed ?agent))
			(is_unsealed ?agent)
		)
	)

	(:action take_pod
		:parameters (?agent - robot ?pod - pod)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent pod_pickup)
			(at ?pod pod_pickup)
			(is_unsealed ?agent)
			(pod_is_empty ?pod)
			(pod_is_available ?pod)
			(> (pod_capacity_available ?agent) 0)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
			(not(at ?pod pod_pickup))
			(not(pod_is_available ?pod))
			(decrease (pod_capacity_available ?agent) 1)
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
		)
	)

	(:action drop_pod
		:parameters (?agent - robot ?pod - pod)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent pod_pickup)
			(is_unsealed ?agent)
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
			(> (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))
		)
		:effect (and
			(increase (seismic_counter) 1)
			(decrease (battery_level ?agent) (+ (+ 50 (* 10 (- (max_capacity ?agent) (capacity_available ?agent)))) (* 5 (- (max_pod_capacity ?agent) (pod_capacity_available ?agent)))))		
			(not (on ?pod ?agent))
			(not (has_pod ?agent ?pod))
			(at ?pod pod_pickup)
			(pod_is_available ?pod)
			(increase (pod_capacity_available ?agent) 1)
		)
	)

	(:action charge_battery
		:parameters (?agent - robot)
		:precondition (and
			(< (seismic_counter) (seismic_phase_duration))
			(at ?agent pod_pickup)
			(= (capacity_available ?agent) (max_capacity ?agent))
			(= (pod_capacity_available ?agent) (max_pod_capacity ?agent))
			(> (battery_level ?agent) 0)
		)
		:effect (and
			(increase (seismic_counter) 1)
			(increase (battery_level ?agent) (- (max_battery_level ?agent) (battery_level ?agent)))
		)
	)

	(:action start_earthquake
		:parameters ()
		:precondition (and
			(>= (seismic_counter) (seismic_phase_duration))
		)
		:effect (and
			(is_seisming hall_beta)
			(not (is_not_seisming hall_beta))
			(assign (seismic_counter) 0)
			)
	)
	
	(:action stop_earthquake
		:parameters ()
		:precondition (and
			(>= (seismic_counter) (seismic_phase_duration))
		)
		:effect (and
			(not (is_seisming hall_beta))
			(is_not_seisming hall_beta)
			(assign (seismic_counter) 0)
		)
	)

	(:task unload_phase :parameters (?agent - robot ?room - room))

	(:method unload_one_standard_more
		:parameters (?agent - robot ?room - room ?artifact - artifact)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
		)
		:ordered-subtasks (and
			(drop_standard_artifact ?agent ?artifact ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_thermosensitive_more
		:parameters (?agent - robot ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_thermosensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_seismic_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_seismic_sensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method unload_one_seismic_and_thermo_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (unload_phase ?agent ?room)
		:precondition (and
			(on ?artifact ?agent)
			(in ?artifact ?pod)
			(has_pod ?agent ?pod)
		)
		:ordered-subtasks (and
			(safe_drop_seismic_and_thermo_sensitive_artifact ?agent ?artifact ?pod ?room)
			(unload_phase ?agent ?room)
		)
	)

	(:method finish_unloading
		:parameters (?agent - robot ?room - room)
		:task (unload_phase ?agent ?room)
		:ordered-subtasks ()
	)

	(:task load_phase :parameters (?r - robot ?room - room))

	(:method load_one_standard_more
		:parameters (?agent - robot ?room - room ?artifact - artifact)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(> (capacity_available ?agent) 0)
		)
		:ordered-subtasks (and
			(pickup_standard_artifact ?agent ?artifact ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method load_one_thermosensitive_more
		:parameters (?agent - drone_curator ?room - room ?artifact - artifact ?pod - pod)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(> (capacity_available ?agent) 0)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(pickup_thermosensitive_artifact ?agent ?artifact ?pod ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method load_one_sensitive_more
		:parameters (?agent - sealing_curators ?room - room ?artifact - artifact ?pod - pod)
		:task (load_phase ?agent ?room)
		:precondition (and 
			(at ?artifact ?room)
			(at ?agent ?room)
			(> (capacity_available ?agent) 0)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(pickup_sensitive_artifact ?agent ?artifact ?pod ?room)
			(load_phase ?agent ?room)
			)
	)

	(:method finish_loading
		:parameters (?agent - robot ?room - room)
		:task (load_phase ?agent ?room)
		:ordered-subtasks ()
	)

	(:task robot_travel
		:parameters (?agent - robot ?destination - location)
	)

	(:method already_at_destination
		:parameters (?agent - robot ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?destination)
		)
		:ordered-subtasks (
		)
	)

	(:method sealing_curator_travel
		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?departure)
			(is_unsealed ?agent)
		)
		:ordered-subtasks (and
			(seal ?agent)
			(move_robot ?agent ?departure ?destination)
			(unseal ?agent)
		)
	)

	(:method drone_curator_travel
		:parameters (?agent - drone_curator ?departure - location ?destination - location)
		:task (robot_travel ?agent ?destination)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(move_robot ?agent ?departure ?destination)
		)
	)

	(:task move_robot
		:parameters (?r - robot ?departure - location ?destination - location)
	)
	
	(:method move_robot_one_location
  		:parameters (?agent - sealing_curators ?departure - location ?destination - location ?intermediate - location)
  		:task (move_robot ?agent ?departure ?destination)
		:precondition (and
			(is_sealed ?agent)
			(are_connected ?departure ?intermediate)
			(at ?agent ?departure)
		)
  		:ordered-subtasks (and
			(move ?agent ?departure ?intermediate)
			(move_robot ?agent ?intermediate ?destination)
  		)
	)

	(:method arrived_at_destination
  		:parameters (?agent - sealing_curators ?departure - location ?destination - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(at ?agent ?destination)
		)
  		:ordered-subtasks (
		)
	)

	(:method fly_drone_one_location
  		:parameters (?agent - drone_curator ?departure - location ?destination - location ?intermediate - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(are_connected ?departure ?intermediate)
		)
  		:ordered-subtasks (and
			(fly ?agent ?departure ?intermediate)
			(move_robot ?agent ?intermediate ?destination)
		)
	)

	(:method flown_at_destination
  		:parameters (?agent - drone_curator ?departure - location ?destination - location)
  		:task (move_robot ?agent ?departure ?destination)
  		:precondition (and
			(at ?agent ?departure)
			(at ?agent ?destination)
		)
  		:ordered-subtasks (
		)
	)

	(:task charge_robot :parameters (?agent - robot))

	(:method charge_robot_at_station
		:parameters (?agent - robot)
		:task (charge_robot ?agent)
		:precondition (and
			(= (capacity_available ?agent) (max_capacity ?agent))
			(= (pod_capacity_available ?agent) (max_pod_capacity ?agent))
		)
		:ordered-subtasks (and
			(robot_travel ?agent pod_pickup)
			(charge_battery ?agent)
		)
	)

	(:task take_pods :parameters (?agent - robot))

	(:method take_one_pod
		:parameters (?agent - robot ?pod - pod)
		:task (take_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
			(> (pod_capacity_available ?agent) 0)
			(pod_is_available ?pod)
			(at ?pod pod_pickup)
		)
		:ordered-subtasks (and
			(take_pod ?agent ?pod)
			(take_pods ?agent)
		)
	)

	(:method finish_taking_pods
		:parameters (?agent - robot)
		:task (take_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
		)
		:ordered-subtasks ()
	)

	(:task fetch_pods :parameters (?agent - robot))

	(:method fetch_pods_from_pod_pickup
		:parameters (?agent - robot)
		:task (fetch_pods ?agent)
		:precondition (and
			(> (pod_capacity_available ?agent) 0)
		)
		:ordered-subtasks (and
			(robot_travel ?agent pod_pickup)
			(take_pods ?agent)
		)
	)

	(:task drop_pods :parameters (?agent - robot))

	(:method drop_one_pod
		:parameters (?agent - robot ?pod - pod)
		:task (drop_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
			(on ?pod ?agent)
			(has_pod ?agent ?pod)
			(pod_is_empty ?pod)
		)
		:ordered-subtasks (and
			(drop_pod ?agent ?pod)
			(drop_pods ?agent)
		)
	)

	(:method finish_dropping_pods
		:parameters (?agent - robot)
		:task (drop_pods ?agent)
		:precondition (and
			(at ?agent pod_pickup)
		)
		:ordered-subtasks ()
	)

	(:task prepare_robot :parameters (?agent - robot ?departure - location))

	(:method prepare_nothing
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition ()
		:ordered-subtasks ()
	)

	(:method prepare_pods
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(fetch_pods ?agent)
		)
	)

	(:method prepare_battery
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(charge_robot ?agent)
		)
	)

	(:method prepare_battery_and_pods
		:parameters (?agent - robot ?departure - location)
		:task (prepare_robot ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(charge_robot ?agent)
			(fetch_pods ?agent)
		)
	)

	(:task service_room :parameters (?agent - robot ?room - room))

	(:method do_service_room
		:parameters (?agent - robot ?room - room)
		:task (service_room ?agent ?room)
		:ordered-subtasks (and
			(unload_phase ?agent ?room)
			(load_phase ?agent ?room)
		)
	)

	(:task conduct_tour :parameters (?agent - robot))

	(:method tour_next_stop
		:parameters (?agent - robot ?next_destination - room)
		:task (conduct_tour ?agent)
		:ordered-subtasks (and
			(robot_travel ?agent ?next_destination)
			(service_room ?agent ?next_destination)
			(conduct_tour ?agent)
		)
	)

	(:method finish_tour
		:parameters (?agent - robot)
		:task (conduct_tour ?agent)
		:ordered-subtasks ()
	)

	(:task tour_around :parameters (?agent - robot ?departure - location))

	(:method do_tour_around
		:parameters (?agent - robot ?departure - location)
		:task (tour_around ?agent ?departure)
		:precondition (and
			(at ?agent ?departure)
		)
		:ordered-subtasks (and
			(prepare_robot ?agent ?departure)
			(conduct_tour ?agent)
		)
	)

	(:task robot_wait_daemon :parameters (?agent - robot))

    (:method finish_waiting
        :parameters (?agent - robot)
        :task (robot_wait_daemon ?agent)
        :ordered-subtasks ()
    )

    (:method do_wait_step
        :parameters (?agent - robot)
        :task (robot_wait_daemon ?agent)
        :precondition (and
        )
        :ordered-subtasks (and
            (wait ?agent)
            (robot_wait_daemon ?agent)
        )
    )

	(:task make_robot_work :parameters (?agent - robot))

	(:method deploy_for_work_once
		:parameters (?agent - robot ?departure - location)
		:task (make_robot_work ?agent)
		:precondition (and
			(at ?agent ?departure)
		)
		:subtasks (and
			(t_act (tour_around ?agent ?departure))
			(t_wait (robot_wait_daemon ?agent))
			(t_work (make_robot_work ?agent))
		)
		:ordering (and
			(< t_act t_work)
			(< t_wait t_work)
		)
	)
	
	(:method finish_work
		:parameters (?agent - robot)
		:task (make_robot_work ?agent)
		:ordered-subtasks ()
	)

	(:task manage_workforce)

	(:method deploy_one_more_robot
        :parameters (?agent - robot)
        :task (manage_workforce)
        :precondition (and
            (is_idle ?agent)
        )
        :subtasks (and
            (t_act (activate_robot ?agent))
            (t_work (make_robot_work ?agent))
            (t_rec (manage_workforce))
        )
        :ordering (and 
            (< t_act t_work)
            (< t_act t_rec)
        )
    )

	(:method finish_deployment
		:task (manage_workforce)
		:ordered-subtasks ()
	)

	(:task earthquake_daemon)

	(:method trigger_earthquake
		:task (earthquake_daemon)
		:precondition (and
			(>= (seismic_counter) (seismic_phase_duration))
			(is_not_seisming hall_beta)
		)
		:ordered-subtasks (and
			(start_earthquake)
			(earthquake_daemon)
		)
	)
	
	(:method trigger_calm
		:task (earthquake_daemon)
		:precondition (and
			(>= (seismic_counter) (seismic_phase_duration))
			(is_seisming hall_beta)
		)
		:ordered-subtasks (and
			(stop_earthquake)
			(earthquake_daemon)
		)
	)
	
	(:method stop_daemon
		:task (earthquake_daemon)
		:ordered-subtasks ()
	)

	(:task solve_problem)

    (:method run_main_task
        :task (solve_problem)
        :subtasks (and
            (t_daemon (earthquake_daemon))
            (t_workforce (manage_workforce))
        )
    )
)